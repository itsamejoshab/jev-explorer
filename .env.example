# Required. Get a key from https://typesafe.ai
# Leave blank (or the placeholder) to route Jev through OpenRouter instead.
TYPESAFE_API_KEY=your_api_key_here

# Fallback: used when TYPESAFE_API_KEY is blank. Requests go to
# https://openrouter.ai/api with model ~typesafe/jev-latest.
# OPENROUTER_API_KEY=your_openrouter_key_here

# Optional overrides
# TYPESAFE_BASE_URL=https://api.typesafe.ai
# TYPESAFE_DEFAULT_MODEL=jev-latest
